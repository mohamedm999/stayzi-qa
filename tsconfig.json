{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@fragments/*": ["fragments/*"],
      "@lib/*": ["lib/*"],
      "@fixtures/*": ["fixtures/*"],
      "@hooks/*": ["hooks/*"]
    }
  },
  "include": [
    "pages/**/*.ts",
    "fragments/**/*.ts",
    "lib/**/*.ts",
    "fixtures/**/*.ts",
    "hooks/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "reports",
    "screenshots",
    "test-results"
  ]
}